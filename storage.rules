rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // Owner of businesses/{businessId}, or the signed-in user whose
    // users/{uid}.businessId is that same hotel. Default Firestore DB only.
    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }
    function isBusinessOwner(businessId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/businesses/$(businessId))
        && firestore.get(/databases/(default)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid;
    }

    function isLicensedOwner(businessId) {
      let license = /databases/(default)/documents/businesses/$(businessId)/settings/license;
      return isBusinessOwner(businessId) && firestore.get(/databases/(default)/documents/businesses/$(businessId)).data.get('enabled', true) == true && firestore.exists(license) && (
        (firestore.get(license).data.expiresAt is timestamp && request.time < firestore.get(license).data.expiresAt) ||
        (firestore.get(license).data.activated != true &&
          firestore.get(license).data.trialStart is timestamp &&
          request.time < firestore.get(license).data.trialStart + duration.value(10, 'd'))
      );
    }

    function isJpegImage() {
      return request.resource.contentType.matches('image/jpe?g.*');
    }

    function sizeOk() {
      return request.resource.size <= 5 * 1024 * 1024;
    }

    function isIdFile(fileName) {
      return fileName == 'id_front.jpg' || fileName == 'id_back.jpg';
    }

    match /businesses/{businessId}/guests/{guestId}/{fileName} {
      allow read: if isAdmin() || isBusinessOwner(businessId);
      allow create, update: if isLicensedOwner(businessId)
        && isJpegImage()
        && sizeOk()
        && isIdFile(fileName);
      allow delete: if false;
    }

    match /businesses/{businessId}/guests/{guestId}/additional/{additionalGuestId}/{fileName} {
      allow read: if isAdmin() || isBusinessOwner(businessId);
      allow create, update: if isLicensedOwner(businessId)
        && isJpegImage()
        && sizeOk()
        && isIdFile(fileName);
      allow delete: if false;
    }
    // New uploads are immutable versions. Old canonical paths remain readable.
    match /businesses/{businessId}/guests/{guestId}/versions/{hash}/{fileName} {
      allow read: if isAdmin() || isBusinessOwner(businessId);
      allow create: if isLicensedOwner(businessId) && isJpegImage() && sizeOk()
        && isIdFile(fileName) && hash.matches('[a-f0-9]{64}');
      allow update: if isLicensedOwner(businessId) && isJpegImage() && sizeOk()
        && isIdFile(fileName) && hash.matches('[a-f0-9]{64}')
        && request.resource.size == resource.size;
      allow delete: if false;
    }
    match /businesses/{businessId}/guests/{guestId}/additional/{additionalGuestId}/versions/{hash}/{fileName} {
      allow read: if isAdmin() || isBusinessOwner(businessId);
      allow create: if isLicensedOwner(businessId) && isJpegImage() && sizeOk()
        && isIdFile(fileName) && hash.matches('[a-f0-9]{64}');
      allow update: if isLicensedOwner(businessId) && isJpegImage() && sizeOk()
        && isIdFile(fileName) && hash.matches('[a-f0-9]{64}')
        && request.resource.size == resource.size;
      allow delete: if false;
    }
  }
}
