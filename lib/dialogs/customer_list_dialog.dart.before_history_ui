import 'dart:convert';

import 'package:flutter/material.dart';
import 'package:flutter/services.dart';

import '../models/customer.dart';
import '../stores/customer_store.dart';

Future<void> showCustomerListDialog(BuildContext context) async {
  final searchController = TextEditingController();

  List<Customer> filteredCustomers = List<Customer>.from(
    CustomerStore.customers,
  );

  Uint8List? photoBytes(String photoData) {
    if (photoData.isEmpty) {
      return null;
    }

    try {
      return base64Decode(photoData);
    } catch (error) {
      return null;
    }
  }

  await showDialog(
    context: context,
    builder: (BuildContext dialogContext) {
      return StatefulBuilder(
        builder: (BuildContext context, StateSetter updateDialog) {
          void searchCustomer(String value) {
            final search = value.trim().toLowerCase();

            updateDialog(() {
              if (search.isEmpty) {
                filteredCustomers = List<Customer>.from(
                  CustomerStore.customers,
                );

                return;
              }

              filteredCustomers = CustomerStore.customers.where((customer) {
                return customer.customerId.toLowerCase().contains(search) ||
                    customer.mobile.toLowerCase().contains(search) ||
                    customer.guestName.toLowerCase().contains(search);
              }).toList();
            });
          }

          Widget photoBox(String title, String photoData) {
            final bytes = photoBytes(photoData);

            return Expanded(
              child: Container(
                height: 120,
                decoration: BoxDecoration(
                  border: Border.all(color: Colors.grey.shade300),
                  borderRadius: BorderRadius.circular(8),
                ),
                child: bytes == null
                    ? Center(
                        child: Text(
                          "$title\nNot Available",
                          textAlign: TextAlign.center,
                        ),
                      )
                    : Column(
                        children: [
                          Padding(
                            padding: const EdgeInsets.all(4),
                            child: Text(
                              title,
                              style: const TextStyle(
                                fontWeight: FontWeight.bold,
                              ),
                            ),
                          ),
                          Expanded(
                            child: Image.memory(bytes, fit: BoxFit.contain),
                          ),
                        ],
                      ),
              ),
            );
          }

          return AlertDialog(
            title: const Text("CUSTOMER LIST / SEARCH"),
            content: SizedBox(
              width: 850,
              height: 600,
              child: Column(
                children: [
                  TextField(
                    controller: searchController,
                    autofocus: true,
                    decoration: const InputDecoration(
                      labelText: "Search Customer ID / Mobile / Guest Name",
                      prefixIcon: Icon(Icons.search),
                      border: OutlineInputBorder(),
                    ),
                    onChanged: searchCustomer,
                  ),
                  const SizedBox(height: 12),
                  Expanded(
                    child: filteredCustomers.isEmpty
                        ? const Center(child: Text("No Customer Found"))
                        : ListView.builder(
                            itemCount: filteredCustomers.length,
                            itemBuilder: (BuildContext context, int index) {
                              final customer = filteredCustomers[index];

                              return Card(
                                margin: const EdgeInsets.only(bottom: 10),
                                child: Padding(
                                  padding: const EdgeInsets.all(12),
                                  child: Column(
                                    crossAxisAlignment:
                                        CrossAxisAlignment.start,
                                    children: [
                                      Text(
                                        customer.customerId,
                                        style: const TextStyle(
                                          fontSize: 18,
                                          fontWeight: FontWeight.bold,
                                        ),
                                      ),
                                      const SizedBox(height: 5),
                                      Text(
                                        "Guest Name : "
                                        "${customer.guestName}",
                                      ),
                                      Text(
                                        "Mobile Number : "
                                        "${customer.mobile}",
                                      ),
                                      Text(
                                        "ID Type : "
                                        "${customer.idType}",
                                      ),
                                      Text(
                                        "ID Number : "
                                        "${customer.idNumber}",
                                      ),
                                      const SizedBox(height: 10),
                                      Row(
                                        children: [
                                          photoBox(
                                            "ID FRONT PHOTO",
                                            customer.idFrontPhotoPath,
                                          ),
                                          const SizedBox(width: 12),
                                          photoBox(
                                            "ID BACK PHOTO",
                                            customer.idBackPhotoPath,
                                          ),
                                        ],
                                      ),
                                    ],
                                  ),
                                ),
                              );
                            },
                          ),
                  ),
                ],
              ),
            ),
            actions: [
              TextButton(
                autofocus: true,
                onPressed: () {
                  Navigator.pop(dialogContext);
                },
                child: const Text("CLOSE"),
              ),
            ],
          );
        },
      );
    },
  );
}
