import 'package:flutter/material.dart';
import 'package:pdf/pdf.dart';
import 'package:pdf/widgets.dart' as pw;
import 'package:printing/printing.dart';

import '../models/bill_record.dart';

Future<void> showBillPreviewDialog(
  BuildContext context,
  BillRecord bill,
) async {
  String formatDateTime(DateTime? date) {
    if (date == null) {
      return "-";
    }

    final String day = date.day.toString().padLeft(2, "0");
    final String month = date.month.toString().padLeft(2, "0");

    int hour = date.hour;
    final String period = hour >= 12 ? "PM" : "AM";

    hour = hour % 12;

    if (hour == 0) {
      hour = 12;
    }

    final String minute = date.minute.toString().padLeft(2, "0");

    return "$day-$month-${date.year}  $hour:$minute $period";
  }

  String stayDuration() {
    if (bill.bookingTime == null) {
      return "-";
    }

    final Duration duration = bill.checkoutTime.difference(bill.bookingTime!);

    final int totalMinutes = duration.inMinutes;
    final int days = totalMinutes ~/ 1440;
    final int hours = (totalMinutes % 1440) ~/ 60;
    final int minutes = totalMinutes % 60;

    final List<String> parts = [];

    if (days > 0) {
      parts.add("$days ${days == 1 ? "Day" : "Days"}");
    }

    if (hours > 0) {
      parts.add("$hours ${hours == 1 ? "Hour" : "Hours"}");
    }

    parts.add("$minutes ${minutes == 1 ? "Minute" : "Minutes"}");

    return parts.join(" ");
  }

  Future<void> printBill() async {
    final pw.Document document = pw.Document();

    pw.Widget billLine(String title, String value, {bool bold = false}) {
      return pw.Padding(
        padding: const pw.EdgeInsets.symmetric(vertical: 2),
        child: pw.Row(
          mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
          children: [
            pw.Text(title),
            pw.Text(
              value,
              style: bold ? pw.TextStyle(fontWeight: pw.FontWeight.bold) : null,
            ),
          ],
        ),
      );
    }

    document.addPage(
      pw.Page(
        pageFormat: PdfPageFormat.a4,
        margin: const pw.EdgeInsets.all(35),
        build: (pw.Context pdfContext) {
          return pw.Column(
            crossAxisAlignment: pw.CrossAxisAlignment.start,
            children: [
              pw.Center(
                child: pw.Text(
                  "SILVER CLOUD HOTEL",
                  style: pw.TextStyle(
                    fontSize: 24,
                    fontWeight: pw.FontWeight.bold,
                  ),
                ),
              ),
              pw.SizedBox(height: 5),
              pw.Center(
                child: pw.Text(
                  "FINAL ROOM BILL",
                  style: pw.TextStyle(
                    fontSize: 15,
                    fontWeight: pw.FontWeight.bold,
                  ),
                ),
              ),
              pw.SizedBox(height: 15),
              pw.Divider(),
              billLine("Bill No.", bill.billNumber, bold: true),
              billLine("Customer ID", bill.customerId),
              billLine("Guest Name", bill.guestName),
              billLine("Mobile Number", bill.mobile),
              pw.Divider(),
              billLine("Room", "${bill.roomNumber} - ${bill.roomType}"),
              billLine(
                "Booking Date / Time",
                formatDateTime(bill.bookingTime ?? bill.bookingDate),
              ),
              billLine(
                "Checkout Date / Time",
                formatDateTime(bill.checkoutTime),
              ),
              billLine("Stay Duration", stayDuration(), bold: true),
              pw.Divider(),
              billLine("Room Rate", "Rs. ${bill.roomRate} / Day"),
              billLine("Booked Days", bill.bookedDays.toString()),
              billLine("Room Bill", "Rs. ${bill.roomBill}"),
              pw.SizedBox(height: 8),
              pw.Text(
                "EXTRA CHARGES",
                style: pw.TextStyle(fontWeight: pw.FontWeight.bold),
              ),
              pw.SizedBox(height: 5),
              if (bill.charges.isEmpty) pw.Text("No Extra Charges"),
              ...bill.charges.map(
                (charge) => billLine(
                  charge["name"]?.toString() ?? "-",
                  "Rs. ${charge["amount"] ?? 0}",
                ),
              ),
              pw.Divider(),
              billLine("TOTAL BILL", "Rs. ${bill.totalBill}", bold: true),
              billLine("ADVANCE", "Rs. ${bill.advance}"),
              billLine("BALANCE PAID", "Rs. ${bill.balance}", bold: true),
              billLine("PAYMENT MODE", bill.paymentMode),
              pw.SizedBox(height: 30),
              pw.Divider(),
              pw.Center(
                child: pw.Text(
                  "Thank You For Staying With Us",
                  style: pw.TextStyle(fontWeight: pw.FontWeight.bold),
                ),
              ),
              pw.SizedBox(height: 5),
              pw.Center(child: pw.Text("SILVER CLOUD HOTEL")),
            ],
          );
        },
      ),
    );

    await Printing.layoutPdf(
      name: bill.billNumber,
      onLayout: (PdfPageFormat format) async {
        return document.save();
      },
    );
  }

  Widget detail(String title, String value, {bool bold = false}) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 3),
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          SizedBox(
            width: 190,
            child: Text(
              title,
              style: const TextStyle(fontWeight: FontWeight.w600),
            ),
          ),
          Expanded(
            child: Text(
              value,
              style: TextStyle(
                fontWeight: bold ? FontWeight.bold : FontWeight.normal,
              ),
            ),
          ),
        ],
      ),
    );
  }

  await showDialog(
    context: context,
    builder: (BuildContext billContext) {
      return AlertDialog(
        titlePadding: EdgeInsets.zero,
        title: Container(
          width: double.infinity,
          padding: const EdgeInsets.all(18),
          decoration: const BoxDecoration(color: Color(0xFF800000)),
          child: const Column(
            children: [
              Text(
                "SILVER CLOUD HOTEL",
                style: TextStyle(
                  color: Colors.white,
                  fontSize: 25,
                  fontWeight: FontWeight.bold,
                ),
              ),
              SizedBox(height: 4),
              Text(
                "FINAL ROOM BILL",
                style: TextStyle(color: Colors.white, fontSize: 15),
              ),
            ],
          ),
        ),
        content: SizedBox(
          width: 650,
          child: SingleChildScrollView(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                detail("Bill Number", bill.billNumber, bold: true),
                detail("Customer ID", bill.customerId),
                detail("Guest Name", bill.guestName),
                detail("Mobile Number", bill.mobile),
                const Divider(),
                detail("Room", "${bill.roomNumber} - ${bill.roomType}"),
                detail(
                  "Booking Date / Time",
                  formatDateTime(bill.bookingTime ?? bill.bookingDate),
                ),
                detail(
                  "Checkout Date / Time",
                  formatDateTime(bill.checkoutTime),
                ),
                detail("Stay Duration", stayDuration(), bold: true),
                const Divider(),
                detail("Room Rate", "₹${bill.roomRate} / Day"),
                detail("Booked Days", bill.bookedDays.toString()),
                detail("Room Bill", "₹${bill.roomBill}"),
                const SizedBox(height: 10),
                const Text(
                  "EXTRA CHARGES",
                  style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold),
                ),
                const SizedBox(height: 5),
                if (bill.charges.isEmpty) const Text("No Extra Charges"),
                ...bill.charges.map(
                  (charge) => detail(
                    charge["name"]?.toString() ?? "-",
                    "₹${charge["amount"] ?? 0}",
                  ),
                ),
                const Divider(),
                detail("TOTAL BILL", "₹${bill.totalBill}", bold: true),
                detail("ADVANCE", "₹${bill.advance}"),
                detail("BALANCE PAID", "₹${bill.balance}", bold: true),
                detail("PAYMENT MODE", bill.paymentMode),
                const SizedBox(height: 15),
                const Center(
                  child: Text(
                    "Thank You For Staying With Us",
                    style: TextStyle(fontWeight: FontWeight.bold),
                  ),
                ),
              ],
            ),
          ),
        ),
        actions: [
          TextButton(
            onPressed: () {
              Navigator.pop(billContext);
            },
            child: const Text("CLOSE"),
          ),
          ElevatedButton.icon(
            autofocus: true,
            onPressed: printBill,
            icon: const Icon(Icons.print),
            label: const Text("PRINT BILL"),
          ),
        ],
      );
    },
  );
}
