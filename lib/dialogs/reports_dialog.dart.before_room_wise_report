import 'package:flutter/material.dart';
import 'package:pdf/pdf.dart';
import 'package:pdf/widgets.dart' as pw;
import 'package:printing/printing.dart';

import '../models/bill_record.dart';
import '../stores/bill_store.dart';
import 'bill_preview_dialog.dart';

Future<void> showReportsDialog(BuildContext context) async {
  DateTime fromDate = DateTime.now();
  DateTime toDate = DateTime.now();

  bool isSameDay(DateTime first, DateTime second) {
    return first.year == second.year &&
        first.month == second.month &&
        first.day == second.day;
  }

  String formatDate(DateTime date) {
    final String day = date.day.toString().padLeft(2, "0");
    final String month = date.month.toString().padLeft(2, "0");

    return "$day-$month-${date.year}";
  }

  String formatDateTime(DateTime date) {
    final String day = date.day.toString().padLeft(2, "0");
    final String month = date.month.toString().padLeft(2, "0");

    int hour = date.hour;
    final String period = hour >= 12 ? "PM" : "AM";

    hour = hour % 12;

    if (hour == 0) {
      hour = 12;
    }

    final String minute = date.minute.toString().padLeft(2, "0");

    return "$day-$month-${date.year} $hour:$minute $period";
  }

  List<BillRecord> billsForRange(DateTime startDate, DateTime endDate) {
    final DateTime start = DateTime(
      startDate.year,
      startDate.month,
      startDate.day,
    );

    final DateTime end = DateTime(
      endDate.year,
      endDate.month,
      endDate.day,
      23,
      59,
      59,
      999,
    );

    final List<BillRecord> bills = BillStore.bills.where((bill) {
      return !bill.checkoutTime.isBefore(start) &&
          !bill.checkoutTime.isAfter(end);
    }).toList();

    bills.sort(
      (first, second) => second.checkoutTime.compareTo(first.checkoutTime),
    );

    return bills;
  }

  Map<String, int> calculateTotals(List<BillRecord> bills) {
    int roomRevenue = 0;
    int extraCharges = 0;
    int totalCollection = 0;
    int cash = 0;
    int upi = 0;
    int card = 0;
    int bankTransfer = 0;

    for (final BillRecord bill in bills) {
      roomRevenue += bill.roomBill;
      extraCharges += bill.extraCharges;
      totalCollection += bill.totalBill;

      final String mode = bill.paymentMode.trim().toLowerCase();

      if (mode == "cash") {
        cash += bill.totalBill;
      } else if (mode == "upi") {
        upi += bill.totalBill;
      } else if (mode == "card") {
        card += bill.totalBill;
      } else if (mode == "bank transfer") {
        bankTransfer += bill.totalBill;
      }
    }

    return {
      "roomRevenue": roomRevenue,
      "extraCharges": extraCharges,
      "totalCollection": totalCollection,
      "cash": cash,
      "upi": upi,
      "card": card,
      "bankTransfer": bankTransfer,
    };
  }

  Future<void> printReport(
    DateTime reportFromDate,
    DateTime reportToDate,
    List<BillRecord> bills,
    Map<String, int> totals,
  ) async {
    final pw.Document pdf = pw.Document();

    pw.Widget summaryLine(String title, String value, {bool bold = false}) {
      return pw.Padding(
        padding: const pw.EdgeInsets.symmetric(vertical: 2),
        child: pw.Row(
          mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
          children: [
            pw.Text(
              title,
              style: pw.TextStyle(
                fontWeight: bold ? pw.FontWeight.bold : pw.FontWeight.normal,
              ),
            ),
            pw.Text(
              value,
              style: pw.TextStyle(
                fontWeight: bold ? pw.FontWeight.bold : pw.FontWeight.normal,
              ),
            ),
          ],
        ),
      );
    }

    pdf.addPage(
      pw.MultiPage(
        pageFormat: PdfPageFormat.a4,
        margin: const pw.EdgeInsets.all(28),
        build: (pw.Context pdfContext) {
          return [
            pw.Center(
              child: pw.Text(
                "SILVER CLOUD HOTEL",
                style: pw.TextStyle(
                  fontSize: 22,
                  fontWeight: pw.FontWeight.bold,
                ),
              ),
            ),
            pw.SizedBox(height: 3),
            pw.Center(
              child: pw.Text(
                "43 SARASWATI NAGAR, UNIVERSITY ROAD, GWALIOR - 474011",
                style: const pw.TextStyle(fontSize: 9),
              ),
            ),
            pw.SizedBox(height: 2),
            pw.Center(
              child: pw.Text(
                "Mobile: 9926299236",
                style: const pw.TextStyle(fontSize: 9),
              ),
            ),
            pw.SizedBox(height: 2),
            pw.Center(
              child: pw.Text(
                "Property / Registration No.: 98986565R565",
                style: const pw.TextStyle(fontSize: 9),
              ),
            ),
            pw.SizedBox(height: 8),
            pw.Center(
              child: pw.Text(
                isSameDay(reportFromDate, reportToDate)
                    ? "DAILY REPORT - ${formatDate(reportFromDate)}"
                    : "REPORT ${formatDate(reportFromDate)} TO ${formatDate(reportToDate)}",
                style: pw.TextStyle(
                  fontSize: 15,
                  fontWeight: pw.FontWeight.bold,
                ),
              ),
            ),
            pw.SizedBox(height: 10),
            pw.Divider(),
            summaryLine("TOTAL BILLS", bills.length.toString(), bold: true),
            summaryLine("ROOM REVENUE", "Rs. ${totals["roomRevenue"]}"),
            summaryLine("EXTRA CHARGES", "Rs. ${totals["extraCharges"]}"),
            summaryLine(
              "TOTAL COLLECTION",
              "Rs. ${totals["totalCollection"]}",
              bold: true,
            ),
            summaryLine("CASH", "Rs. ${totals["cash"]}"),
            summaryLine("UPI", "Rs. ${totals["upi"]}"),
            summaryLine("CARD", "Rs. ${totals["card"]}"),
            summaryLine("BANK TRANSFER", "Rs. ${totals["bankTransfer"]}"),
            pw.SizedBox(height: 12),
            pw.Divider(),
            pw.Text(
              "BILL DETAILS",
              style: pw.TextStyle(fontSize: 13, fontWeight: pw.FontWeight.bold),
            ),
            pw.SizedBox(height: 8),
            if (bills.isEmpty)
              pw.Center(child: pw.Text("No Bills Found For Selected Date")),
            if (bills.isNotEmpty)
              pw.Table(
                border: pw.TableBorder.all(width: 0.5),
                columnWidths: const {
                  0: pw.FlexColumnWidth(1.4),
                  1: pw.FlexColumnWidth(1.4),
                  2: pw.FlexColumnWidth(0.7),
                  3: pw.FlexColumnWidth(1.2),
                  4: pw.FlexColumnWidth(0.8),
                  5: pw.FlexColumnWidth(0.9),
                },
                children: [
                  pw.TableRow(
                    children:
                        [
                          "Bill No.",
                          "Guest",
                          "Room",
                          "Checkout",
                          "Mode",
                          "Amount",
                        ].map((title) {
                          return pw.Padding(
                            padding: const pw.EdgeInsets.all(5),
                            child: pw.Text(
                              title,
                              style: pw.TextStyle(
                                fontWeight: pw.FontWeight.bold,
                                fontSize: 8,
                              ),
                            ),
                          );
                        }).toList(),
                  ),
                  ...bills.map((bill) {
                    return pw.TableRow(
                      children:
                          [
                            bill.billNumber,
                            bill.guestName,
                            bill.roomNumber.toString(),
                            formatDateTime(bill.checkoutTime),
                            bill.paymentMode,
                            "Rs. ${bill.totalBill}",
                          ].map((value) {
                            return pw.Padding(
                              padding: const pw.EdgeInsets.all(5),
                              child: pw.Text(
                                value,
                                style: const pw.TextStyle(fontSize: 8),
                              ),
                            );
                          }).toList(),
                    );
                  }),
                ],
              ),
            pw.SizedBox(height: 20),
            pw.Divider(),
            pw.Center(
              child: pw.Text(
                "SILVER CLOUD HOTEL - DAILY REPORT",
                style: pw.TextStyle(
                  fontWeight: pw.FontWeight.bold,
                  fontSize: 9,
                ),
              ),
            ),
          ];
        },
      ),
    );

    await Printing.layoutPdf(
      onLayout: (PdfPageFormat format) async {
        return pdf.save();
      },
    );
  }

  Widget reportBox(String title, String value, IconData icon) {
    return Container(
      width: 180,
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        border: Border.all(color: Colors.grey.shade400),
        borderRadius: BorderRadius.circular(10),
      ),
      child: Column(
        children: [
          Icon(icon, size: 28),
          const SizedBox(height: 7),
          Text(
            value,
            style: const TextStyle(fontSize: 22, fontWeight: FontWeight.bold),
          ),
          const SizedBox(height: 3),
          Text(title, textAlign: TextAlign.center),
        ],
      ),
    );
  }

  await showDialog(
    context: context,
    builder: (BuildContext dialogContext) {
      return StatefulBuilder(
        builder: (BuildContext context, StateSetter updateDialog) {
          final List<BillRecord> selectedBills = billsForRange(
            fromDate,
            toDate,
          );

          final Map<String, int> totals = calculateTotals(selectedBills);

          final bool showingToday =
              isSameDay(fromDate, DateTime.now()) &&
              isSameDay(toDate, DateTime.now());

          final bool singleDate = isSameDay(fromDate, toDate);

          final int reportDays =
              DateTime(toDate.year, toDate.month, toDate.day)
                  .difference(
                    DateTime(fromDate.year, fromDate.month, fromDate.day),
                  )
                  .inDays +
              1;

          return AlertDialog(
            titlePadding: EdgeInsets.zero,
            title: Container(
              width: double.infinity,
              padding: const EdgeInsets.all(18),
              decoration: const BoxDecoration(color: Color(0xFF800000)),
              child: Column(
                children: [
                  const Text(
                    "SILVER CLOUD HOTEL",
                    style: TextStyle(
                      color: Colors.white,
                      fontSize: 24,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                  const SizedBox(height: 4),
                  Text(
                    showingToday
                        ? "TODAY REPORT"
                        : singleDate
                        ? "REPORT - ${formatDate(fromDate)}"
                        : "REPORT ${formatDate(fromDate)} TO ${formatDate(toDate)}",
                    style: const TextStyle(color: Colors.white, fontSize: 16),
                  ),
                ],
              ),
            ),
            content: SizedBox(
              width: 900,
              height: 680,
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Wrap(
                    spacing: 10,
                    runSpacing: 10,
                    children: [
                      ElevatedButton.icon(
                        onPressed: () {
                          updateDialog(() {
                            fromDate = DateTime.now();
                            toDate = DateTime.now();
                          });
                        },
                        icon: const Icon(Icons.today),
                        label: const Text("TODAY"),
                      ),
                      ElevatedButton.icon(
                        onPressed: () async {
                          final DateTime? pickedDate = await showDatePicker(
                            context: dialogContext,
                            initialDate: fromDate,
                            firstDate: DateTime(2020),
                            lastDate: DateTime.now(),
                          );

                          if (pickedDate != null) {
                            updateDialog(() {
                              fromDate = pickedDate;

                              if (toDate.isBefore(fromDate)) {
                                toDate = fromDate;
                              }
                            });
                          }
                        },
                        icon: const Icon(Icons.date_range),
                        label: Text("FROM : ${formatDate(fromDate)}"),
                      ),
                      ElevatedButton.icon(
                        onPressed: () async {
                          final DateTime? pickedDate = await showDatePicker(
                            context: dialogContext,
                            initialDate: toDate,
                            firstDate: fromDate,
                            lastDate: DateTime.now(),
                          );

                          if (pickedDate != null) {
                            updateDialog(() {
                              toDate = pickedDate;
                            });
                          }
                        },
                        icon: const Icon(Icons.event_available),
                        label: Text("TO : ${formatDate(toDate)}"),
                      ),
                      ElevatedButton.icon(
                        onPressed: () async {
                          await printReport(
                            fromDate,
                            toDate,
                            selectedBills,
                            totals,
                          );
                        },
                        icon: const Icon(Icons.print),
                        label: const Text("PRINT PDF REPORT"),
                      ),
                      Container(
                        padding: const EdgeInsets.symmetric(
                          horizontal: 14,
                          vertical: 10,
                        ),
                        decoration: BoxDecoration(
                          border: Border.all(color: Colors.grey.shade400),
                          borderRadius: BorderRadius.circular(8),
                        ),
                        child: Text(
                          "DURATION : $reportDays ${reportDays == 1 ? "DAY" : "DAYS"}",
                          style: const TextStyle(fontWeight: FontWeight.bold),
                        ),
                      ),
                    ],
                  ),
                  const SizedBox(height: 15),
                  Wrap(
                    spacing: 10,
                    runSpacing: 10,
                    children: [
                      reportBox(
                        showingToday ? "TODAY BILLS" : "TOTAL BILLS",
                        selectedBills.length.toString(),
                        Icons.receipt_long,
                      ),
                      reportBox(
                        "ROOM REVENUE",
                        "₹${totals["roomRevenue"]}",
                        Icons.hotel,
                      ),
                      reportBox(
                        "EXTRA CHARGES",
                        "₹${totals["extraCharges"]}",
                        Icons.add_card,
                      ),
                      reportBox(
                        "TOTAL COLLECTION",
                        "₹${totals["totalCollection"]}",
                        Icons.currency_rupee,
                      ),
                      reportBox("CASH", "₹${totals["cash"]}", Icons.payments),
                      reportBox("UPI", "₹${totals["upi"]}", Icons.qr_code),
                      reportBox(
                        "CARD",
                        "₹${totals["card"]}",
                        Icons.credit_card,
                      ),
                      reportBox(
                        "BANK TRANSFER",
                        "₹${totals["bankTransfer"]}",
                        Icons.account_balance,
                      ),
                    ],
                  ),
                  const SizedBox(height: 20),
                  Text(
                    showingToday
                        ? "TODAY BILLS"
                        : singleDate
                        ? "BILLS - ${formatDate(fromDate)}"
                        : "BILLS ${formatDate(fromDate)} TO ${formatDate(toDate)}",
                    style: const TextStyle(
                      fontSize: 19,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                  const Divider(),
                  Expanded(
                    child: selectedBills.isEmpty
                        ? Center(
                            child: Text(
                              singleDate
                                  ? "No Bills Found For ${formatDate(fromDate)}"
                                  : "No Bills Found From ${formatDate(fromDate)} To ${formatDate(toDate)}",
                              style: const TextStyle(fontSize: 17),
                            ),
                          )
                        : ListView.separated(
                            itemCount: selectedBills.length,
                            separatorBuilder:
                                (BuildContext context, int index) {
                                  return const Divider();
                                },
                            itemBuilder: (BuildContext context, int index) {
                              final BillRecord bill = selectedBills[index];

                              return ListTile(
                                leading: const Icon(Icons.receipt_long),
                                title: Text(
                                  "${bill.billNumber}  •  ${bill.guestName}",
                                  style: const TextStyle(
                                    fontWeight: FontWeight.bold,
                                  ),
                                ),
                                subtitle: Text(
                                  "Room ${bill.roomNumber}  •  "
                                  "${formatDateTime(bill.checkoutTime)}  •  "
                                  "${bill.paymentMode}",
                                ),
                                trailing: Row(
                                  mainAxisSize: MainAxisSize.min,
                                  children: [
                                    Text(
                                      "₹${bill.totalBill}",
                                      style: const TextStyle(
                                        fontSize: 17,
                                        fontWeight: FontWeight.bold,
                                      ),
                                    ),
                                    const SizedBox(width: 15),
                                    ElevatedButton.icon(
                                      onPressed: () async {
                                        await showBillPreviewDialog(
                                          dialogContext,
                                          bill,
                                        );
                                      },
                                      icon: const Icon(Icons.visibility),
                                      label: const Text("VIEW BILL"),
                                    ),
                                  ],
                                ),
                              );
                            },
                          ),
                  ),
                ],
              ),
            ),
            actions: [
              TextButton(
                autofocus: true,
                onPressed: () {
                  Navigator.pop(dialogContext);
                },
                child: const Text("CLOSE"),
              ),
            ],
          );
        },
      );
    },
  );
}
