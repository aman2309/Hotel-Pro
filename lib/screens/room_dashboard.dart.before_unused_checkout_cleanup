  Future<void> addRoom() async {
    final roomNumberController = TextEditingController();
    final roomTypeController = TextEditingController();
    final roomRentController = TextEditingController();

    final typeFocus = FocusNode();
    final rentFocus = FocusNode();

    await showDialog(
      context: context,
      builder: (BuildContext dialogContext) {
        void saveRoom() {
          final roomNumber = int.tryParse(roomNumberController.text);
          final roomType = roomTypeController.text.trim();
          final roomRent = int.tryParse(roomRentController.text);

          if (roomNumber == null ||
              roomType.isEmpty ||
              roomRent == null ||
              roomRent <= 0) {
            return;
          }

          final roomAlreadyExists = rooms.any((room) {
            return room.roomNumber == roomNumber;
          });

          if (roomAlreadyExists) {
            ScaffoldMessenger.of(context).showSnackBar(
              SnackBar(content: Text("Room $roomNumber already exists")),
            );
            return;
          }

          setState(() {
            rooms.add(
              Room(
                roomNumber: roomNumber,
                roomType: roomType,
                normalRent: roomRent,
              ),
            );

            rooms.sort((firstRoom, secondRoom) {
              return firstRoom.roomNumber.compareTo(secondRoom.roomNumber);
            });
          });

          Navigator.pop(dialogContext);
        }

        return AlertDialog(
          title: const Text("Add New Room"),
          content: SizedBox(
            width: 420,
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                TextField(
                  controller: roomNumberController,
                  autofocus: true,
                  keyboardType: TextInputType.number,
                  textInputAction: TextInputAction.next,
                  decoration: const InputDecoration(labelText: "Room Number"),
                  onSubmitted: (value) {
                    typeFocus.requestFocus();
                  },
                ),
                TextField(
                  controller: roomTypeController,
                  focusNode: typeFocus,
                  textInputAction: TextInputAction.next,
                  decoration: const InputDecoration(labelText: "Room Type"),
                  onSubmitted: (value) {
                    rentFocus.requestFocus();
                  },
                ),
                TextField(
                  controller: roomRentController,
                  focusNode: rentFocus,
                  keyboardType: TextInputType.number,
                  textInputAction: TextInputAction.done,
                  decoration: const InputDecoration(
                    labelText: "Normal Rent Per Day",
                  ),
                  onSubmitted: (value) {
                    saveRoom();
                  },
                ),
              ],
            ),
          ),
          actions: [
            TextButton(
              onPressed: () {
                Navigator.pop(dialogContext);
              },
              child: const Text("CANCEL"),
            ),
            ElevatedButton.icon(
              onPressed: saveRoom,
              icon: const Icon(Icons.add),
              label: const Text("ADD ROOM"),
            ),
          ],
        );
      },
    );
  }

  Future<void> deleteRoom() async {
    final emptyRooms = rooms.where((room) {
      return room.status == "EMPTY";
    }).toList();

    if (emptyRooms.isEmpty) {
      return;
    }

    Room? selectedRoom;

    final roomSelected = await showDialog<bool>(
      context: context,
      builder: (BuildContext dialogContext) {
        return StatefulBuilder(
          builder: (BuildContext context, StateSetter updateDialog) {
            return AlertDialog(
              title: const Text("Select Room To Delete"),
              content: SizedBox(
                width: 420,
                child: DropdownButtonFormField<Room>(
                  decoration: const InputDecoration(
                    labelText: "Select EMPTY Room",
                    border: OutlineInputBorder(),
                  ),
                  items: emptyRooms.map((room) {
                    return DropdownMenuItem<Room>(
                      value: room,
                      child: Text("Room ${room.roomNumber} - ${room.roomType}"),
                    );
                  }).toList(),
                  onChanged: (Room? room) {
                    updateDialog(() {
                      selectedRoom = room;
                    });
                  },
                ),
              ),
              actions: [
                TextButton(
                  onPressed: () {
                    Navigator.pop(dialogContext, false);
                  },
                  child: const Text("CANCEL"),
                ),
                ElevatedButton.icon(
                  onPressed: selectedRoom == null
                      ? null
                      : () {
                          Navigator.pop(dialogContext, true);
                        },
                  icon: const Icon(Icons.delete),
                  label: const Text("DELETE"),
                ),
              ],
            );
          },
        );
      },
    );

    if (roomSelected != true || selectedRoom == null || !mounted) {
      return;
    }

    final room = selectedRoom!;

    final deleteConfirmed = await showDialog<bool>(
      context: context,
      builder: (BuildContext dialogContext) {
        return AlertDialog(
          title: const Text("Delete Room?"),
          content: Text(
            "Are you sure you want to delete Room ${room.roomNumber}?",
          ),
          actions: [
            TextButton(
              onPressed: () {
                Navigator.pop(dialogContext, false);
              },
              child: const Text("NO"),
            ),
            ElevatedButton.icon(
              onPressed: () {
                Navigator.pop(dialogContext, true);
              },
              icon: const Icon(Icons.delete_forever),
              label: const Text("YES, DELETE"),
            ),
          ],
        );
      },
    );

    if (deleteConfirmed == true && mounted) {
      setState(() {
        rooms.remove(room);
      });
    }
  }

  Future<void> editRoom() async {
    final editableRooms = rooms.where((room) {
      return room.status == "EMPTY";
    }).toList();

    if (editableRooms.isEmpty) {
      return;
    }

    Room? selectedRoom;

    bool? roomSelected = await showDialog<bool>(
      context: context,
      builder: (BuildContext dialogContext) {
        return StatefulBuilder(
          builder: (BuildContext context, StateSetter updateDialog) {
            return AlertDialog(
              title: const Text("Select Room To Edit"),
              content: SizedBox(
                width: 420,
                child: DropdownButtonFormField<Room>(
                  decoration: const InputDecoration(
                    labelText: "Select EMPTY Room",
                    border: OutlineInputBorder(),
                  ),
                  items: editableRooms.map((room) {
                    return DropdownMenuItem<Room>(
                      value: room,
                      child: Text("Room ${room.roomNumber} - ${room.roomType}"),
                    );
                  }).toList(),
                  onChanged: (Room? room) {
                    updateDialog(() {
                      selectedRoom = room;
                    });
                  },
                ),
              ),
              actions: [
                TextButton(
                  onPressed: () {
                    Navigator.pop(dialogContext, false);
                  },
                  child: const Text("CANCEL"),
                ),
                ElevatedButton.icon(
                  onPressed: selectedRoom == null
                      ? null
                      : () {
                          Navigator.pop(dialogContext, true);
                        },
                  icon: const Icon(Icons.edit),
                  label: const Text("EDIT"),
                ),
              ],
            );
          },
        );
      },
    );

    if (roomSelected != true || selectedRoom == null || !mounted) {
      return;
    }

    final room = selectedRoom!;

    final roomNumberController = TextEditingController(
      text: room.roomNumber.toString(),
    );
    final roomTypeController = TextEditingController(text: room.roomType);
    final roomRentController = TextEditingController(
      text: room.normalRent.toString(),
    );

    final typeFocus = FocusNode();
    final rentFocus = FocusNode();

    await showDialog(
      context: context,
      builder: (BuildContext dialogContext) {
        void saveRoomChanges() {
          final roomNumber = int.tryParse(roomNumberController.text);
          final roomType = roomTypeController.text.trim();
          final roomRent = int.tryParse(roomRentController.text);

          if (roomNumber == null ||
              roomType.isEmpty ||
              roomRent == null ||
              roomRent <= 0) {
            return;
          }

          final roomAlreadyExists = rooms.any((otherRoom) {
            return otherRoom != room && otherRoom.roomNumber == roomNumber;
          });

          if (roomAlreadyExists) {
            return;
          }

          setState(() {
            room.roomNumber = roomNumber;
            room.roomType = roomType;
            room.normalRent = roomRent;
            room.bookingRate = roomRent;
            room.futureBookingRate = roomRent;

            rooms.sort((firstRoom, secondRoom) {
              return firstRoom.roomNumber.compareTo(secondRoom.roomNumber);
            });
          });

          Navigator.pop(dialogContext);
        }

        return AlertDialog(
          title: Text("Edit Room ${room.roomNumber}"),
          content: SizedBox(
            width: 420,
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                TextField(
                  controller: roomNumberController,
                  autofocus: true,
                  keyboardType: TextInputType.number,
                  textInputAction: TextInputAction.next,
                  decoration: const InputDecoration(labelText: "Room Number"),
                  onSubmitted: (value) {
                    typeFocus.requestFocus();
                  },
                ),
                TextField(
                  controller: roomTypeController,
                  focusNode: typeFocus,
                  textInputAction: TextInputAction.next,
                  decoration: const InputDecoration(labelText: "Room Type"),
                  onSubmitted: (value) {
                    rentFocus.requestFocus();
                  },
                ),
                TextField(
                  controller: roomRentController,
                  focusNode: rentFocus,
                  keyboardType: TextInputType.number,
                  textInputAction: TextInputAction.done,
                  decoration: const InputDecoration(
                    labelText: "Normal Rent Per Day",
                  ),
                  onSubmitted: (value) {
                    saveRoomChanges();
                  },
                ),
              ],
            ),
          ),
          actions: [
            TextButton(
              onPressed: () {
                Navigator.pop(dialogContext);
              },
              child: const Text("CANCEL"),
            ),
            ElevatedButton.icon(
              onPressed: saveRoomChanges,
              icon: const Icon(Icons.save),
              label: const Text("SAVE CHANGES"),
            ),
          ],
        );
      },
    );
  }

