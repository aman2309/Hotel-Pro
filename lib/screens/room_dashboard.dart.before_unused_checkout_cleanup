  Future<void> saveRooms() async {
    final prefs = await SharedPreferences.getInstance();

    final roomData = rooms.map((room) => room.toJson()).toList();

    await prefs.setString("silver_cloud_rooms", jsonEncode(roomData));
  }

  Future<void> loadRooms() async {
    final prefs = await SharedPreferences.getInstance();

    final savedData = prefs.getString("silver_cloud_rooms");

    if (savedData == null) {
      await saveRooms();
      return;
    }

    final decoded = jsonDecode(savedData) as List<dynamic>;

    final loadedRooms = decoded
        .map((item) => Room.fromJson(Map<String, dynamic>.from(item as Map)))
        .toList();

    if (!mounted) {
      return;
    }

    setState(() {
      rooms
        ..clear()
        ..addAll(loadedRooms);

      for (final Room room in rooms) {
        if (room.status == "BOOKED" && room.bookingTime == null) {
          room.bookingTime = room.bookingDate ?? DateTime.now();
        }
      }
    });
  }

  @override
  void setState(VoidCallback fn) {
    super.setState(fn);
    saveRooms();
  }

  Color getRoomColor(String status) {
    if (status == "EMPTY") {
      return Colors.green.shade700;
    }

    if (status == "BOOKED") {
      return Colors.red.shade700;
    }

    if (status == "CLEANING") {
      return Colors.amber.shade700;
    }

    return const Color(0xFF800000);
  }

  int countStatus(String status) {
    return rooms.where((room) {
      return room.status == status;
    }).length;
  }

  String formatDate(DateTime date) {
    String day = date.day.toString().padLeft(2, "0");

    String month = date.month.toString().padLeft(2, "0");

    return "$day-$month-${date.year}";
  }

  Future<void> changeRoom(Room oldRoom) async {
    List<Room> availableRooms = rooms.where((room) {
      return room.status == "EMPTY" &&
          room.roomNumber != oldRoom.roomNumber &&
          room.futureBooking == false;
    }).toList();

    if (availableRooms.isEmpty) {
      if (!mounted) {
        return;
      }

      await showDialog(
        context: context,
        builder: (BuildContext dialogContext) {
          return AlertDialog(
            title: const Text("No Room Available"),
            content: const Text("No empty room is available for room change."),
            actions: [
              TextButton(
                onPressed: () {
                  Navigator.pop(dialogContext);
                },
                child: const Text("OK"),
              ),
            ],
          );
        },
      );

      return;
    }

    Room? selectedRoom;

    bool? changeConfirmed = await showDialog<bool>(
      context: context,
      builder: (BuildContext dialogContext) {
        return StatefulBuilder(
          builder: (BuildContext context, StateSetter updateDialog) {
            return AlertDialog(
              title: Text("Change Room ${oldRoom.roomNumber}"),
              content: SizedBox(
                width: 450,
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      "Guest : ${oldRoom.guestName}",
                      style: const TextStyle(
                        fontSize: 17,
                        fontWeight: FontWeight.bold,
                      ),
                    ),

                    const SizedBox(height: 5),

                    Text("Current Room : ${oldRoom.roomNumber}"),

                    const SizedBox(height: 20),

                    DropdownButtonFormField<Room>(
                      initialValue: selectedRoom,
                      decoration: const InputDecoration(
                        labelText: "Select New Room",
                        border: OutlineInputBorder(),
                        prefixIcon: Icon(Icons.hotel),
                      ),
                      items: availableRooms.map((Room room) {
                        return DropdownMenuItem<Room>(
                          value: room,
                          child: Text(
                            "Room ${room.roomNumber}  |  "
                            "${room.roomType}  |  "
                            "₹${room.normalRent}",
                          ),
                        );
                      }).toList(),
                      onChanged: (Room? room) {
                        updateDialog(() {
                          selectedRoom = room;
                        });
                      },
                    ),

                    if (selectedRoom != null) ...[
                      const SizedBox(height: 20),

                      const Divider(),

                      Text(
                        "New Room : "
                        "${selectedRoom!.roomNumber}",
                      ),

                      Text(
                        "Room Type : "
                        "${selectedRoom!.roomType}",
                      ),

                      Text(
                        "Normal Rent : "
                        "₹${selectedRoom!.normalRent} / Day",
                      ),

                      const SizedBox(height: 10),

                      const Text(
                        "Guest and current billing will be transferred to the new room.",
                        style: TextStyle(fontWeight: FontWeight.bold),
                      ),
                    ],
                  ],
                ),
              ),
              actions: [
                TextButton(
                  onPressed: () {
                    Navigator.pop(dialogContext, false);
                  },
                  child: const Text("CANCEL"),
                ),

                ElevatedButton.icon(
                  onPressed: selectedRoom == null
                      ? null
                      : () {
                          Navigator.pop(dialogContext, true);
                        },
                  icon: const Icon(Icons.swap_horiz),
                  label: const Text("CONFIRM ROOM CHANGE"),
                ),
              ],
            );
          },
        );
      },
    );

    if (changeConfirmed != true || selectedRoom == null) {
      return;
    }

    Room newRoom = selectedRoom!;

    setState(() {
      newRoom.mobile = oldRoom.mobile;
      newRoom.guestName = oldRoom.guestName;
      newRoom.idNumber = oldRoom.idNumber;

      newRoom.bookingRate = oldRoom.bookingRate;
      newRoom.bookingDate = oldRoom.bookingDate;
      newRoom.days = oldRoom.days;
      newRoom.advance = oldRoom.advance;
      newRoom.paymentMode = oldRoom.paymentMode;

      newRoom.charges = List<Map<String, dynamic>>.from(oldRoom.charges);

      newRoom.extraGuests = oldRoom.extraGuests
          .map((guest) => Map<String, dynamic>.from(guest))
          .toList();

      newRoom.status = "BOOKED";
      newRoom.futureBooking = false;

      oldRoom.mobile = "";
      oldRoom.guestName = "";
      oldRoom.idNumber = "";

      oldRoom.bookingRate = oldRoom.normalRent;
      oldRoom.bookingDate = null;
      oldRoom.days = 0;
      oldRoom.advance = 0;
      oldRoom.paymentMode = "";

      oldRoom.charges = [];
      oldRoom.extraGuests = [];

      oldRoom.status = "EMPTY";
      oldRoom.futureBooking = false;
    });

    if (!mounted) {
      return;
    }

    await showDialog(
      context: context,
      builder: (BuildContext successContext) {
        return AlertDialog(
          title: const Text("Room Changed Successfully"),
          content: Text(
            "Guest : ${newRoom.guestName}\n\n"
            "Old Room : ${oldRoom.roomNumber}\n"
            "New Room : ${newRoom.roomNumber}\n\n"
            "Room ${oldRoom.roomNumber} is now EMPTY.\n"
            "Room ${newRoom.roomNumber} is now BOOKED.",
          ),
          actions: [
            TextButton(
              autofocus: true,
              onPressed: () {
                Navigator.pop(successContext);
              },
              child: const Text("OK"),
            ),
          ],
        );
      },
    );
  }

  Future<void> checkoutRoom(Room room) async {
    int roomBill = room.bookingRate * room.days;

    int extraCharges = 0;

    for (final charge in room.charges) {
      extraCharges += charge["amount"] as int;
    }

    int totalBill = roomBill + extraCharges;
    int balance = totalBill - room.advance;

    String paymentMode = "Cash";

    bool? paymentConfirmed = await showDialog<bool>(
      context: context,
      barrierDismissible: false,
      builder: (BuildContext dialogContext) {
        return StatefulBuilder(
          builder: (BuildContext context, StateSetter updateDialog) {
            return AlertDialog(
              title: Text("Checkout Room ${room.roomNumber}"),
              content: SizedBox(
                width: 480,
                child: SingleChildScrollView(
                  child: Column(
                    mainAxisSize: MainAxisSize.min,
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(
                        "Guest : ${room.guestName}",
                        style: const TextStyle(
                          fontSize: 18,
                          fontWeight: FontWeight.bold,
                        ),
                      ),

                      Text("Mobile : ${room.mobile}"),

                      const Divider(),

                      Text(
                        "Room Rent : "
                        "₹${room.bookingRate} × "
                        "${room.days} Days",
                      ),

                      Text("Room Bill : ₹$roomBill"),

                      const SizedBox(height: 10),

                      const Text(
                        "Extra Charges",
                        style: TextStyle(fontWeight: FontWeight.bold),
                      ),

                      if (room.charges.isEmpty) const Text("No Extra Charges"),

                      ...room.charges.map<Widget>((charge) {
                        return Text(
                          "${charge["name"]} : "
                          "₹${charge["amount"]}",
                        );
                      }),

                      const Divider(),

                      Text(
                        "TOTAL BILL : ₹$totalBill",
                        style: const TextStyle(
                          fontSize: 20,
                          fontWeight: FontWeight.bold,
                        ),
                      ),

                      Text("ADVANCE : ₹${room.advance}"),

                      Text(
                        "BALANCE PAYMENT : ₹$balance",
                        style: const TextStyle(
                          color: Colors.red,
                          fontSize: 20,
                          fontWeight: FontWeight.bold,
                        ),
                      ),

                      const SizedBox(height: 20),

                      DropdownButtonFormField<String>(
                        initialValue: paymentMode,
                        decoration: const InputDecoration(
                          labelText: "Balance Payment Mode",
                          border: OutlineInputBorder(),
                          prefixIcon: Icon(Icons.payment),
                        ),
                        items: const [
                          DropdownMenuItem(value: "Cash", child: Text("Cash")),
                          DropdownMenuItem(value: "UPI", child: Text("UPI")),
                          DropdownMenuItem(value: "Card", child: Text("Card")),
                          DropdownMenuItem(
                            value: "Bank Transfer",
                            child: Text("Bank Transfer"),
                          ),
                        ],
                        onChanged: (String? value) {
                          if (value != null) {
                            updateDialog(() {
                              paymentMode = value;
                            });
                          }
                        },
                      ),

                      const SizedBox(height: 15),

                      const Text(
                        "After payment, room status will change to CLEANING.",
                        style: TextStyle(fontWeight: FontWeight.bold),
                      ),
                    ],
                  ),
                ),
              ),
              actions: [
                TextButton(
                  onPressed: () {
                    Navigator.pop(dialogContext, false);
                  },
                  child: const Text("CANCEL"),
                ),

                ElevatedButton.icon(
                  onPressed: () {
                    Navigator.pop(dialogContext, true);
                  },
                  icon: const Icon(Icons.check_circle),
                  label: Text("RECEIVE ₹$balance & CHECKOUT"),
                ),
              ],
            );
          },
        );
      },
    );

    if (paymentConfirmed != true) {
      return;
    }

    setState(() {
      room.paymentMode = paymentMode;
      room.checkoutTime = DateTime.now();
      room.status = "CLEANING";
      room.futureBooking = false;
    });

    final Customer? billCustomer = CustomerStore.findByMobile(room.mobile);

    final String billNumber = BillStore.nextBillNumber();

    final BillRecord finalBill = BillRecord(
      billNumber: billNumber,
      customerId: billCustomer?.customerId ?? "-",
      guestName: room.guestName,
      mobile: room.mobile,
      roomNumber: room.roomNumber,
      roomType: room.roomType,
      bookingDate: room.bookingDate,
      bookingTime: room.bookingTime,
      checkoutTime: room.checkoutTime!,
      roomRate: room.bookingRate,
      bookedDays: room.days,
      roomBill: roomBill,
      charges: List<Map<String, dynamic>>.from(room.charges),
      extraCharges: extraCharges,
      totalBill: totalBill,
      advance: room.advance,
      balance: balance,
      paymentMode: paymentMode,
    );

    await BillStore.saveBill(finalBill);

    await CustomerStore.addStayHistory(room.mobile, {
      "roomNumber": room.roomNumber,
      "bookingDate": room.bookingDate?.toIso8601String(),
      "bookingTime": room.bookingTime?.toIso8601String(),
      "checkoutTime": room.checkoutTime?.toIso8601String(),
      "roomRate": room.bookingRate,
      "days": room.days,
      "roomBill": roomBill,
      "extraCharges": extraCharges,
      "charges": List<Map<String, dynamic>>.from(room.charges),
      "totalBill": totalBill,
      "advance": room.advance,
      "balance": balance,
      "paymentMode": paymentMode,
    });

    for (final Map<String, dynamic> guest in room.extraGuests) {
      final String extraMobile = guest["mobile"]?.toString() ?? "";

      if (extraMobile.isEmpty) {
        continue;
      }

      await CustomerStore.addStayHistory(extraMobile, {
        "roomNumber": room.roomNumber,
        "bookingDate": room.bookingDate?.toIso8601String(),
        "bookingTime": room.bookingTime?.toIso8601String(),
        "checkoutTime": room.checkoutTime?.toIso8601String(),
        "roomRate": room.bookingRate,
        "days": room.days,
        "roomBill": roomBill,
        "extraCharges": extraCharges,
        "charges": List<Map<String, dynamic>>.from(room.charges),
        "totalBill": totalBill,
        "advance": room.advance,
        "balance": balance,
        "paymentMode": paymentMode,
        "sharedStay": true,
        "primaryGuestMobile": room.mobile,
      });
    }

    if (!mounted) {
      return;
    }

    String formatCheckoutTime(DateTime? date) {
      if (date == null) {
        return "-";
      }

      int hour = date.hour;
      final String period = hour >= 12 ? "PM" : "AM";

      hour = hour % 12;

      if (hour == 0) {
        hour = 12;
      }

      final String minute = date.minute.toString().padLeft(2, "0");

      return "$hour:$minute $period";
    }

    String stayDuration = "-";

    if (room.bookingTime != null && room.checkoutTime != null) {
      final Duration duration = room.checkoutTime!.difference(
        room.bookingTime!,
      );

      final int totalMinutes = duration.inMinutes;
      final int stayDays = totalMinutes ~/ 1440;
      final int stayHours = (totalMinutes % 1440) ~/ 60;
      final int stayMinutes = totalMinutes % 60;

      final List<String> durationParts = [];

      if (stayDays > 0) {
        durationParts.add("$stayDays ${stayDays == 1 ? "Day" : "Days"}");
      }

      if (stayHours > 0) {
        durationParts.add("$stayHours ${stayHours == 1 ? "Hour" : "Hours"}");
      }

      durationParts.add(
        "$stayMinutes "
        "${stayMinutes == 1 ? "Minute" : "Minutes"}",
      );

      stayDuration = durationParts.join(" ");
    }

    await showBillPreviewDialog(context, finalBill);
  }

  Future<void> completeCleaning(Room room) async {
    bool? confirmed = await showDialog<bool>(
      context: context,
      builder: (BuildContext dialogContext) {
        return AlertDialog(
          title: Text("Room ${room.roomNumber} Cleaning"),
          content: const Text(
            "Is room cleaning complete?\n\n"
            "Guest and old billing data will be cleared.",
          ),
          actions: [
            TextButton(
              onPressed: () {
                Navigator.pop(dialogContext, false);
              },
              child: const Text("CANCEL"),
            ),
            ElevatedButton.icon(
              onPressed: () {
                Navigator.pop(dialogContext, true);
              },
              icon: const Icon(Icons.cleaning_services),
              label: const Text("CLEANING COMPLETE"),
            ),
          ],
        );
      },
    );

    if (confirmed != true) {
      return;
    }

    setState(() {
      room.mobile = "";
      room.guestName = "";
      room.idNumber = "";

      room.bookingRate = room.normalRent;
      room.bookingDate = null;
      room.days = 0;
      room.advance = 0;
      room.paymentMode = "";

      room.charges = [];
      room.extraGuests = [];

      room.status = "EMPTY";
      room.futureBooking = false;
    });

    if (!mounted) {
      return;
    }

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text("Room ${room.roomNumber} is now EMPTY")),
    );
  }

